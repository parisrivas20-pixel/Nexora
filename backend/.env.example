# Environment Configuration for NEXORA Backend
# DO NOT COMMIT SENSITIVE VALUES TO VERSION CONTROL

PROJECT_NAME="NEXORA - AI Knowledge Dependency & Readiness System"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Database Configuration (PostgreSQL by default; supports SQLite fallback for local test execution)
DATABASE_URL="sqlite:///./nexora.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/nexora_db"

# Security & JWT Tokens
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="change_this_to_a_secure_random_secret_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
